{
  "appId": "top.izuna.ncat",
  "appName": "网飞猫",
  "backgroundColor": "#0b0b10",
  "webDir": "www",
  "ios": {
    "contentInset": "always",
    "limitsNavigationsToAppBoundDomains": false,
    "preferredContentMode": "mobile",
    "scrollEnabled": true
  },
  "server": {
    "androidScheme": "https",
    "cleartext": false,
    "hostname": "localhost",
    "iosScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "backgroundColor": "#0b0b10",
      "iosSpinnerStyle": "small",
      "launchAutoHide": true,
      "launchShowDuration": 600,
      "showSpinner": false
    },
    "StatusBar": {
      "backgroundColor": "#0b0b10",
      "overlaysWebView": true,
      "style": "LIGHT"
    }
  }
}
